{
  "name": "doorline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm --prefix server install && npm --prefix client install --include=dev",
    "heroku-postbuild": "npm run install:all && npm run build",
    "seed:admin": "npm --prefix server run seed:admin",
    "seed:demo": "npm --prefix server run seed:demo --",
    "lock:account": "npm --prefix server run lock:account --",
    "mail:preview": "npm --prefix server run mail:preview --",
    "purge:deleted-identities": "npm --prefix server run purge:deleted-identities --",
    "reconcile:counts": "npm --prefix server run reconcile:counts --",
    "audit:voted-doors": "npm --prefix server run audit:voted-doors --",
    "audit:stale-overwrites": "npm --prefix server run audit:stale-overwrites --",
    "audit:orphaned-reviews": "npm --prefix server run audit:orphaned-reviews --",
    "cleanup:test-campaigns": "npm --prefix server run cleanup:test-campaigns --",
    "migrate:build-indexes": "npm --prefix server run migrate:build-indexes --",
    "migrate:multitenant": "npm --prefix server run migrate:multitenant",
    "migrate:timezones": "npm --prefix server run migrate:timezones --",
    "migrate:survey-dedup": "npm --prefix server run migrate:survey-dedup --",
    "migrate:survey-option-ids": "npm --prefix server run migrate:survey-option-ids --",
    "migrate:org-tags": "npm --prefix server run migrate:org-tags --",
    "migrate:cleanup-client-role": "npm --prefix server run migrate:cleanup-client-role --",
    "migrate:ack-memberships": "npm --prefix server run migrate:ack-memberships --",
    "migrate:efforts": "npm --prefix server run migrate:efforts --",
    "migrate:passes": "npm --prefix server run migrate:passes --",
    "migrate:persons": "npm --prefix server run migrate:persons --",
    "migrate:billing": "npm --prefix server run migrate:billing --",
    "migrate:billing-access": "npm --prefix server run migrate:billing-access --",
    "migrate:campaign-stats": "npm --prefix server run migrate:campaign-stats --",
    "migrate:strip-geocode-raw": "npm --prefix server run migrate:strip-geocode-raw --",
    "migrate:geocode-lastused": "npm --prefix server run migrate:geocode-lastused --",
    "migrate:scrub-map-points": "npm --prefix server run migrate:scrub-map-points --",
    "migrate:deletion-snapshots": "npm --prefix server run migrate:deletion-snapshots --",
    "migrate:platform-stats": "npm --prefix server run migrate:platform-stats --",
    "migrate:candidate-orgs": "npm --prefix server run migrate:candidate-orgs --",
    "request:org-deletion": "npm --prefix server run request:org-deletion --",
    "migrate:voter-scope": "npm --prefix server run migrate:voter-scope --",
    "migrate:cut-attributes": "npm --prefix server run migrate:cut-attributes --",
    "migrate:activity-turf-tags": "npm --prefix server run migrate:activity-turf-tags --",
    "migrate:turf-indexes": "npm --prefix server run migrate:turf-indexes --",
    "migrate:activity-coordinator": "npm --prefix server run migrate:activity-coordinator --",
    "migrate:campaign-coordinators": "npm --prefix server run migrate:campaign-coordinators --",
    "repair:orphaned-assignments": "npm --prefix server run repair:orphaned-assignments --",
    "audit:team-counts": "npm --prefix server run audit:team-counts --",
    "repair:team-stamps": "npm --prefix server run repair:team-stamps --",
    "delete:account": "npm --prefix server run delete:account --",
    "audit:cross-org-identity": "npm --prefix server run audit:cross-org-identity --",
    "migrate:persons-org-scope": "npm --prefix server run migrate:persons-org-scope --",
    "migrate:platform-roles": "npm --prefix server run migrate:platform-roles --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
