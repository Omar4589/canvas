    "questions": [
      { "key": "q1", "type": "single_choice", "label": "Can we count on you?", "required": true, "options": [
        { "id": "yes", "text": "Yes", "goTo": "p" },
        { "id": "no", "text": "No", "goTo": "__end__" }
      ] },
      { "key": "p", "type": "single_choice", "label": "Which issue matters most?", "required": false, "options": [
        { "id": "roads", "text": "Roads" },
        { "id": "parks", "text": "Parks" }
      ] },
