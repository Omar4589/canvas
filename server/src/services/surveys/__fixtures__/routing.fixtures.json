    ]
  },
  {
    "name": "retired answers neither fire nor count",
    "questions": [
      { "key": "q1", "type": "single_choice", "label": "Will you take a yard sign?", "options": [
        { "id": "yes", "text": "Yes", "goTo": "sign" },
        { "id": "maybe", "text": "Maybe", "retired": true, "goTo": "sign" },
        { "id": "later", "text": "Later", "retired": true, "goTo": "gone" },
        { "id": "no", "text": "No", "goTo": "__end__" }
      ] },
      { "key": "sign", "type": "statement", "role": "closing", "title": "Sign", "label": "Great, a volunteer will drop one off.", "options": [], "goTo": "__end__" }
    ],
    "expectedErrors": [],
    "expectedVisibleIf": {
      "q1": null,
      "sign": { "logic": "any", "rules": [{ "questionKey": "q1", "op": "any_of", "optionIds": ["yes"] }] }
    },
    "paths": [
      { "name": "a stored retired answer routes nowhere", "answers": { "q1": ["maybe"] }, "expectedVisibleKeys": ["q1"] },
      { "name": "a live answer still routes", "answers": { "q1": ["yes"] }, "expectedVisibleKeys": ["q1", "sign"] }
    ]
  },
  {
    "name": "a retired answer's route is not a way in",
    "questions": [
      { "key": "q1", "type": "single_choice", "label": "Can we count on you?", "options": [
