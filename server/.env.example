PORT=4000
NODE_ENV=development

# Mongo
MONGODB_URI=mongodb://127.0.0.1:27017/canvass-app

# Auth
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=30d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Custom domains (production only). API_HOST locks that host to /api/* and
# redirects every other path to WEB_ORIGIN. Leave both unset in local dev.
# API_HOST=api.doorline.app
# WEB_ORIGIN=https://doorline.app

# Mapbox (public token starting with pk.* — used by the admin web map)
MAPBOX_PUBLIC_TOKEN=

# Geocoding (Geocodio) — fills lat/long for import files that lack coordinates.
# OFF by default: with GEOCODE_ENABLED unset/false, imports behave exactly as before
# (rows without coordinates are dropped). Set both to turn it on.
GEOCODE_ENABLED=false
GEOCODIO_API_KEY=
# Tunables (sensible defaults baked in — only set to override):
# GEOCODIO_API_VERSION=v2         # public Geocodio API version (default v2 = current; v1.7/v1.8 also work, v1.9+ are enterprise-only)
# GEOCODE_BATCH_SIZE=1000         # addresses per request (Geocodio hard cap 10000; smaller stays within the timeout + makes retries cheap)
# GEOCODE_BATCH_TIMEOUT_MS=180000 # abort a batch after this (worker has no platform timeout, so generous is fine)
# GEOCODE_MIN_ACCURACY=0.5        # reject matches below this 0–1 score
# GEOCODE_NEGCACHE_TTL_DAYS=30    # re-try an unplaceable address after this many days
# GEOCODE_NEGCACHE_MAX_ATTEMPTS=4

# Redis (BullMQ job queue). Heroku Key-Value Store injects REDIS_URL as rediss://.
REDIS_URL=redis://127.0.0.1:6379
IMPORT_JOB_CONCURRENCY=2
TURF_JOB_CONCURRENCY=1

# First admin (used by seed:admin script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
